# ==============================================================================
# Application Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host Ports for Services
# ------------------------------------------------------------------------------
HTTP_PORT=8000

# ------------------------------------------------------------------------------
# 2. General Backend Settings (Pydantic Settings: APP_CONFIG__...)
# ------------------------------------------------------------------------------
APP_CONFIG__ENVIRONMENT=local
APP_CONFIG__DEBUG=True
APP_CONFIG__API__V1_PREFIX=/api/v1
APP_CONFIG__API__CORS_ORIGINS='["http://localhost", "https://localhost", "http://127.0.0.1", "http://localhost:3000", "http://localhost:5173", "http://localhost:8000"]'

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database
# ------------------------------------------------------------------------------
APP_CONFIG__DB__USER=devops_user
APP_CONFIG__DB__PASSWORD=devops_secret_password
APP_CONFIG__DB__NAME=devops_db
APP_CONFIG__DB__HOST=127.0.0.1
APP_CONFIG__DB__PORT=5432
APP_CONFIG__DB__ECHO=False

# ------------------------------------------------------------------------------
# 4. Redis (Cache, Sessions, Tasks)
# ------------------------------------------------------------------------------
APP_CONFIG__REDIS__HOST=127.0.0.1
APP_CONFIG__REDIS__PORT=6379
APP_CONFIG__REDIS__PASSWORD=devops_redis_password
APP_CONFIG__REDIS__DB=0
APP_CONFIG__CACHE__EXPIRE=3600

# ------------------------------------------------------------------------------
# 5. Security & Auth
# ------------------------------------------------------------------------------
APP_CONFIG__AUTH__ACCESS_SECRET_KEY=super-secret-jwt-signing-key-minimum-32-characters-devops-platform
APP_CONFIG__AUTH__ALGORITHM=HS256
APP_CONFIG__AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 6. Logging & Storage
# ------------------------------------------------------------------------------
APP_CONFIG__LOG__DIR=logs
APP_CONFIG__LOG__LEVEL=INFO
APP_CONFIG__STORAGE__DIR=storage
